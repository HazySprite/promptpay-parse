{
  "name": "promptpay-parse",
  "version": "1.0.1",
  "description": "Zero-dependency TypeScript library for PromptPay & EMVCo QR Codes — parse, generate and validate. Works in Node.js, Next.js, Nuxt and browsers.",
  "author": "hazysprite",
  "license": "MIT",
  "keywords": [
    "emvco",
    "emvco-qr",
    "promptpay",
    "promptpay-qr",
    "qr",
    "qrcode",
    "thai-qr-payment",
    "thai-qr-standard",
    "truemoney",
    "bot-barcode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hazysprite/promptpay-parse.git"
  },
  "bugs": {
    "url": "https://github.com/hazysprite/promptpay-parse/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "browser": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./generate": {
      "import": {
        "types": "./dist/generate/index.d.mts",
        "default": "./dist/generate/index.mjs"
      },
      "require": {
        "types": "./dist/generate/index.d.ts",
        "default": "./dist/generate/index.js"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/validate/index.d.mts",
        "default": "./dist/validate/index.mjs"
      },
      "require": {
        "types": "./dist/validate/index.d.ts",
        "default": "./dist/validate/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
